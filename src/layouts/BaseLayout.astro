---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/visual-tuning.css";

interface Props {
  title: string;
  description: string;
  lang?: "hu" | "en";
}

const { title, description, lang = "hu" } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <Header lang={lang} />

    <main class="site-main">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>
