---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  lang="en"
  title="Request a Quote – B&G Engineering"
  description="Request a quote for mechanical design, fixtures, jigs, DFM support and prototyping tasks."
>
  <section class="hero compact">
    <p class="eyebrow">Request a quote</p>
    <h1>Describe the engineering task briefly.</h1>
    <p class="lead">
      A complete technical package is not required for the first request. It is enough
      to describe the project goal, available information and the main constraints.
    </p>
  </section>

  <section class="content-section">
    <div class="note-box form-status-box">
      <strong>MVP / test status:</strong> the form now routes to a controlled thank-you page,
      but database storage, email notification and file upload are not connected yet. The final
      Cloudflare D1 / R2 / Turnstile backend will be added in a later phase.
    </div>

    <form
      class="quote-form"
      method="post"
      action="/en/thank-you/"
      enctype="multipart/form-data"
      data-static-form="quote-request"
      data-thank-you="/en/thank-you/"
    >
      <label>
        Name
        <input type="text" name="name" autocomplete="name" required />
      </label>

      <label>
        Company
        <input type="text" name="company" autocomplete="organization" />
      </label>

      <label>
        Email
        <input type="email" name="email" autocomplete="email" required />
      </label>

      <label>
        Phone
        <input type="tel" name="phone" autocomplete="tel" />
      </label>

      <label>
        Project type
        <select name="project_type" required>
          <option value="">Select project type</option>
          <option value="mechanical_design">Mechanical design</option>
          <option value="fixture_jig">Fixture, jig or production aid</option>
          <option value="dfm_dfa">DFM / DFA support</option>
          <option value="prototype_3d_printing">Prototype or 3D printing</option>
          <option value="documentation">Drawing, documentation or legacy material cleanup</option>
          <option value="other">Other engineering task</option>
        </select>
      </label>

      <label>
        Short task description
        <textarea name="project_description" rows="7" required></textarea>
      </label>

      <label>
        What is currently available?
        <textarea name="available_inputs" rows="5" placeholder="For example: hand sketch, old drawing, 3D model, photo, sample part, dimensions, existing machine or process description."></textarea>
      </label>

      <label>
        Related file upload
        <input type="file" name="attachments" multiple accept=".pdf,.jpg,.jpeg,.png,.webp,.step,.stp,.stl,.iges,.igs,.dxf,.dwg,.zip,.txt,.doc,.docx,.xls,.xlsx" disabled />
        <span class="form-help">
          The file upload field is prepared, but actual upload will only be active after Cloudflare R2 storage is connected.
          Until then, this field remains disabled in test mode.
        </span>
      </label>

      <label>
        Required timeline or schedule
        <input type="text" name="timeline" placeholder="For example: urgent, 2–3 weeks, next month, still under planning" />
      </label>

      <label>
        Notes, manufacturing or assembly constraints
        <textarea name="constraints" rows="5" placeholder="For example: material, manufacturing process, space limitation, existing component, standard, maintenance access."></textarea>
      </label>

      <label class="checkbox-label">
        <input type="checkbox" name="privacy_acknowledged" required />
        I understand that this is an initial quote request and that the provided information is used to respond to the request.
      </label>

      <button class="button" type="submit">Test quote request</button>
    </form>

    <p class="note form-status-note">
      Before live use, this form must be connected to real email notification, D1 data storage, R2 file handling and Turnstile protection.
    </p>

    <div class="cta-box">
      <h2>Not sure how to describe it?</h2>
      <p>
        If you are not sure what exactly you need, contact us first.
      </p>
      <div class="button-row">
        <a class="button secondary" href="/en/contact/">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>