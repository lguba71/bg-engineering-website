---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  lang="en"
  title="B&G Engineering – Mechanical Design Support"
  description="External mechanical design support for manufacturing, automation and prototyping projects."
>
<section class="hero">
  <p class="eyebrow">Manufacturing-focused mechanical design</p>

  <h1>Mechanical design for manufacturing and automation projects.</h1>

  <p class="lead">
    External engineering capacity for special-purpose machines, fixtures, jigs,
    DFM tasks, prototypes and 3D-printing-supported development.
  </p>

  <div class="button-row">
    <a class="button" href="/en/request-quote/">Request quote</a>
    <a class="button secondary" href="/en/services/">Services</a>
  </div>
</section>

  <section class="service-grid">
    <article class="card">
      <h2>Mechanical design</h2>
      <p>CAD modelling, mechanical assemblies and manufacturing-focused documentation.</p>
    </article>

    <article class="card">
      <h2>Fixtures and jigs</h2>
      <p>Assembly, positioning, inspection and production-support fixtures.</p>
    </article>

    <article class="card">
      <h2>DFM / DFA support</h2>
      <p>Practical review for manufacturability, assembly and maintenance access.</p>
    </article>

    <article class="card">
      <h2>Prototyping and 3D printing</h2>
      <p>Test parts, fixture components and small-batch technical parts.</p>
    </article>
  </section>
</BaseLayout>
